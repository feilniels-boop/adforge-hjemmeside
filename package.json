{
  "name": "staticforge-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:stop": "pkill -f '[n]ext dev' 2>/dev/null || true",
    "predev": "npm run dev:stop",
    "dev:fresh": "npm run dev:stop && rm -rf .next && npm run dev",
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3000",
    "dev:turbo": "next dev --turbopack --hostname 127.0.0.1 --port 3000",
    "open": "open http://127.0.0.1:3000",
    "server": "next dev --webpack --hostname 127.0.0.1 --port 3090",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@swc/helpers": "0.5.15",
    "next": "16.2.4",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
